---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import TeachingLayout from "../../layouts/TeachingLayout.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections } from "../../site-config";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({ params: { slug: assessment.id }, props: { assessment } }));
}
const { assessment } = Astro.props;
const { Content, headings } = await render(assessment);
---
<TeachingLayout title={assessment.data.title} description={assessment.data.description} eyebrow="Assessment brief" breadcrumbs={[{ label: "Assessment", href: "/assessments/" }]} metadata={[{ label: "Due", value: formatCourseDate(assessment.data.due) }, { label: "Weight", value: `${assessment.data.weight}% of the final grade` }]} headings={headings}>
  {assessment.data.draft && <Callout type="warning"><p><strong>Draft.</strong> This brief is still being finalised and may change.</p></Callout>}
  <Content />
  <SpecList spec={assessment.data.spec} heading="Submission checklist">Use this checklist before submitting your work.</SpecList>
  {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}
  <RelatedContent entry={assessment} collections={graphCollections} heading="Sources and connected seminars" />
</TeachingLayout>
