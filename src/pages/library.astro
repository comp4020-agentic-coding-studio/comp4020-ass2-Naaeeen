---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import TeachingLayout from "../layouts/TeachingLayout.astro";
import { formatTeachingDeadline } from "../data/teaching-rhythm";
import "../styles/study-guide.css";
const [lectures, assessments] = await Promise.all([getPublishedCollection("lectures"), getPublishedCollection("assessments")]);
const notes = [...lectures].sort((left, right) => left.data.week - right.data.week);
const briefs = [...assessments].sort((left, right) => left.data.due.getTime() - right.data.due.getTime());
---
<TeachingLayout title="Library" description="Materials to return to while you study. Your weekly plan identifies the required reading and the order to use it." eyebrow="Case files · notes · support" wide={true}>
  <div class="study-guide study-library">
    <p class="study-library-introduction">Looking for your next task? <a href={withBase("/sessions/")}>Open the Weekly plan</a>. Use this page when you need a particular reading, presentation, brief or point of support.</p>
    <section class="study-library-shelf" aria-labelledby="study-library-materials"><div class="study-section-label"><p class="study-kicker">For the week's work</p><h2 id="study-library-materials">Case files and notes</h2><p>Follow the weekly guide's reading order. Its preparatory notes are included in the stated allowance; Week 2 notes and slides also support the in-class worked example.</p></div><div>
      <div class="study-library-feature"><p class="study-kicker">Required accounts</p><h3><a href={withBase("/sources/")}>Open the case-file collection <span aria-hidden="true">↗</span></a></h3><p>Course-compiled accounts introduce the events and give stable paragraph locations for your evidence.</p><a href={withBase("/sources/#use-and-credit-a-source")}>How to read and cite an account</a></div>
      <h3 class="study-library-subheading"><a href={withBase("/lectures/")}>All lecture notes &amp; slides <span aria-hidden="true">↗</span></a></h3><p class="study-library-note">These are reading materials, not additional timetabled lectures. The Week 2 presentation also supports work during the seminar.</p><ul class="study-library-notes">{notes.map((lecture) => <li><span class="study-library-week">Week {String(lecture.data.week).padStart(2, "0")}</span><div><a href={withBase(`/lectures/${lecture.id}/`)}>{lecture.data.title}</a><span>Notes{lecture.data.slides ? " and slides" : ""}</span></div>{lecture.data.slides && <a class="study-library-slides" href={withBase(lecture.data.slides)}>Open slides <span aria-hidden="true">↗</span></a>}</li>)}</ul>
    </div></section>

    <section class="study-library-shelf" aria-labelledby="study-library-assessments"><div class="study-section-label"><p class="study-kicker">Work towards the course mark</p><h2 id="study-library-assessments">Assessment briefs</h2><p>Plan separate work blocks for these pieces. Each brief explains the output, criteria and hand-in process.</p><a href={withBase("/policies/#handing-in-work-and-receiving-feedback")}>Handing in work and receiving feedback</a></div><ol class="study-library-assessments">{briefs.map((assessment) => <li><span class="study-library-weight">{assessment.data.weight}<small>%</small></span><div><h3><a href={withBase(`/assessments/${assessment.id}/`)}>{assessment.data.title}</a></h3><p>{assessment.data.description}</p><time datetime={assessment.data.due.toISOString()}>{formatTeachingDeadline(assessment.data.due)}</time></div></li>)}</ol></section>

    <section class="study-library-shelf" aria-labelledby="study-library-support"><div class="study-section-label"><p class="study-kicker">When you need a hand</p><h2 id="study-library-support">Support and course guidance</h2><p>Use these when a question about the work, access or arrangements is getting in your way.</p></div><ul class="study-library-directory"><li><h3><a href={withBase("/people/")}>People and support <span aria-hidden="true">↗</span></a></h3><p>Find the teaching team and how to ask for help.</p></li><li><h3><a href={withBase("/policies/")}>Course policies <span aria-hidden="true">↗</span></a></h3><p>Check meeting arrangements, accessible study, assessment and feedback procedures.</p></li><li><h3><a href={withBase("/sources/credits/")}>Source credits <span aria-hidden="true">↗</span></a></h3><p>Inspect how the accounts were prepared and follow their underlying sources.</p></li></ul></section>

    <section class="study-library-shelf study-library-optional" aria-labelledby="study-library-explore"><div class="study-section-label"><p class="study-kicker">Optional exploration</p><h2 id="study-library-explore">Look beyond the week's route</h2><p>Return to these when you want more context. They are not extra preparation requirements.</p></div><ul class="study-library-directory"><li><h3><a href={withBase("/atlas/")}>World atlas <span aria-hidden="true">↗</span></a></h3><p>Explore connections between the course's virtual worlds and the questions they raise.</p></li><li><h3><a href={withBase("/sources/methods/")}>Computing and design lenses <span aria-hidden="true">↗</span></a></h3><p>Extend a question through optional material on interfaces, incident analysis and accessibility.</p></li><li><h3><a href={withBase("/sources/#event-chronology")}>Event chronology <span aria-hidden="true">↗</span></a></h3><p>Place the course accounts in sequence and return to the source behind each event.</p></li></ul></section>
  </div>
</TeachingLayout>
